# Keep Node-only tests, internal planning notes, and repository metadata out of
# the static site deployment. Wrangler reads .assetsignore from the configured
# assets directory (the repo root in wrangler.jsonc) and uses .gitignore syntax.
tests/
node_modules/
.wrangler/
package*.json
pnpm-lock.yaml
yarn.lock
IMPLEMENTATION_PLAN.md
CHANGELOG.md
wrangler.jsonc
.assetsignore
.git/
.gitignore

# Local credentials, secrets, certificates, and infrastructure state.
.env
.env.*
.envrc
.dev.vars
.dev.vars.*
.npmrc
.pypirc
.netrc
credentials.json
secrets.json
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.p8
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
